# Configuración de DESARROLLO LOCAL para docker-compose.dev.yml:
#   cp .env.example .env.dev      (npm run stack:up del front lo hace solo si falta)
# Credenciales de ejemplo, solo para uso local.
#
# Para ejecutar con `go run` en el host: POSTGRES_HOST=localhost y
# AUTH_JWKS_URL=http://localhost:18080/.well-known/jwks.json

# Puerto de la API (dentro del contenedor y publicado en el host).
APP_PORT=8080

# config.go lee POSTGRES_* (no DB_*). El contenedor de Postgres usa estas mismas
# variables para crear el usuario y la base la primera vez (volumen vacío).
# Las migraciones se aplican solas al arrancar la API.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=kali_invoice
POSTGRES_PASSWORD=kali_invoice_local_only
POSTGRES_DB=kali_invoices_dev
POSTGRES_SSLMODE=disable

RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=kali.invoice
RABBITMQ_ROUTING_KEY=invoice.status.changed

# ========== AUTENTICACIÓN (kali-auth-context) ==========
# El servicio valida los access tokens RS256 con las claves públicas (JWKS) de
# kali-auth-context y toma el tenant del claim "tid". Sin AUTH_JWKS_URL no arranca.
# AUTH_JWKS_URL depende de dónde corre este servicio:
#   - en el host (go run):        http://localhost:18080/.well-known/jwks.json
#   - en Docker (compose dev):    http://host.docker.internal:18080/.well-known/jwks.json
# JWT_ISSUER/JWT_AUDIENCE deben ser idénticos a los de kali-auth-context
# (valores unificados: http://localhost:8080 / account).
AUTH_JWKS_URL=http://host.docker.internal:18080/.well-known/jwks.json
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=account

# Estado de la empresa: además del token, cada petición exige que la empresa siga
# activa (GET /api/v1/auth/session de kali-auth-context con el mismo token). Así una
# suspensión bloquea también los tokens ya emitidos.
# AUTH_SESSION_URL es opcional: por defecto se deriva de AUTH_JWKS_URL.
# AUTH_SESSION_URL=http://host.docker.internal:18080/api/v1/auth/session
# Segundos que se recuerda el estado por empresa (0 = consultar siempre).
TENANT_STATUS_CACHE_SECONDS=5
